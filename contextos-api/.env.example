# ContextOS API Environment Configuration
APP_NAME="ContextOS API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database (Default: zero-dependency SQLite; Production: postgresql+asyncpg://...)
DATABASE_URL="sqlite+aiosqlite:///./contextos.db"
DATABASE_ECHO=False

# Security
SECRET_KEY="contextos-insecure-dev-secret-key-32b"
API_TOKEN="demo-contextos-token"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# MCP Server
MCP_ENABLED=True
MCP_SERVER_NAME="contextos-mcp"

